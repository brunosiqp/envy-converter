<Window x:Class="EnvyConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Envy Converter" Width="1040" Height="680" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}"
        Icon="pack://application:,,,/Assets/app.ico"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="pack://application:,,,/Assets/app.png" Width="22" Height="22" />
                <TextBlock x:Name="AppTitle" Text="Envy Converter" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                <Border CornerRadius="6" Background="{DynamicResource SurfaceHighBrush}" Margin="10,0,0,0" Padding="7,2" VerticalAlignment="Center">
                    <TextBlock Text="PDF → DOCX e mais" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimizar" />
                <Button Style="{StaticResource TitleButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximizar" />
                <Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Fechar" />
            </StackPanel>
            <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource LineBrush}" />
        </Grid>

        <Grid Grid.Row="1" Margin="20,18,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Coluna esquerda: arquivos -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="2,0,0,14">
                    <TextBlock Text="Converta sem perder nada" FontSize="24" FontWeight="Bold" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="O original nunca é alterado. Cada arquivo gerado é aberto e conferido antes de ser salvo." />
                </StackPanel>

                <!-- Área de soltar -->
                <Grid Grid.Row="1" Height="150" Cursor="Hand" MouseLeftButtonUp="OnPickFiles" Background="Transparent">
                    <Rectangle x:Name="DropRect" RadiusX="14" RadiusY="14" StrokeThickness="2" StrokeDashArray="5 4"
                               Stroke="{DynamicResource LineBrush}" Fill="{DynamicResource SurfaceBrush}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Arraste os arquivos aqui ou clique para escolher" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,12,0,2" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                   Text="PDF, DOCX, DOC, RTF, ODT, TXT e HTML" />
                    </StackPanel>
                </Grid>

                <!-- Lista de arquivos -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="12,8,8,6">
                            <TextBlock x:Name="FilesHeader" Text="ARQUIVOS" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="10,4" FontSize="12"
                                    Content="Limpar lista" Click="OnClear" x:Name="ClearButton" />
                        </Grid>
                        <TextBlock x:Name="EmptyHint" Grid.Row="1" Style="{StaticResource Muted}" FontSize="13"
                                   Text="Nenhum arquivo ainda." HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="FileList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="6,3" Padding="12,10" CornerRadius="10" Background="{DynamicResource SurfaceHighBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="44" Height="30" CornerRadius="7" Background="{DynamicResource BgBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Extension}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource Accent2Brush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Detail}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border CornerRadius="8" Padding="9,3" Background="{Binding StatusBrush}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#0E1120" />
                                                    </Border>
                                                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="10,4" FontSize="12"
                                                            Content="Abrir" Click="OnOpenOutput" Tag="{Binding}"
                                                            Visibility="{Binding OpenVisibility}" />
                                                    <Button Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="8,4" FontSize="12"
                                                            Content="&#xE711;" FontFamily="Segoe MDL2 Assets" ToolTip="Remover da lista"
                                                            Click="OnRemove" Tag="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Coluna direita: opções -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="CONVERTER PARA" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="FormatList" Style="{StaticResource ChipList}" SelectionChanged="OnOptionChanged" />
                        <TextBlock x:Name="FormatHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <TextBlock Text="MOTOR DE CONVERSÃO" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="EngineList" Style="{StaticResource ChipList}" SelectionChanged="OnOptionChanged" />
                        <TextBlock x:Name="EngineHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock Text="SALVAR EM" Style="{StaticResource SectionTitle}" />
                        <Border CornerRadius="9" Background="{DynamicResource SurfaceHighBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12,9">
                            <TextBlock x:Name="OutputFolderText" Text="Mesma pasta do arquivo original" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Escolher pasta…" Click="OnPickFolder" FontSize="12" />
                            <Button Style="{StaticResource GhostButton}" Content="Usar a do original" Click="OnResetFolder" FontSize="12" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <TextBlock x:Name="ProgressText" Style="{StaticResource Muted}" Margin="0,0,0,8" Text="Pronto." />
                        <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Value="0" Margin="0,0,0,14" />
                        <Button x:Name="ConvertButton" Style="{StaticResource PrimaryButton}" Content="Converter" Click="OnConvert" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Rodapé -->
        <Grid Grid.Row="2" Margin="22,0,22,0">
            <TextBlock x:Name="EngineStatus" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Style="{StaticResource Muted}">
                <Run Text="Desenvolvido por" />
                <Run Text="Bruno Siqueira" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            </TextBlock>
        </Grid>
    </Grid>
</Window>
