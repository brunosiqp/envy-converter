<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>EnvyConverter</RootNamespace>
    <AssemblyName>EnvyConverter</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Envy Converter</Product>
    <Version>1.2.0</Version>
    <Authors>Bruno Siqueira</Authors>
    <Company>Bruno Siqueira</Company>
    <Copyright>Desenvolvido por Bruno Siqueira</Copyright>
    <Description>Conversor de PDF para DOCX e outros formatos, sem corromper arquivos.</Description>

    <!-- Executável único, sem precisar instalar .NET -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Sem compressão: executáveis que se autodescompactam são vistos com mais desconfiança pelos antivírus. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <FileVersion>1.2.0.0</FileVersion>
    <AssemblyTitle>Envy Converter</AssemblyTitle>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\autor.png" />
    <None Include="tema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
