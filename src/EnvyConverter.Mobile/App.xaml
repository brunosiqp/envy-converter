<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EnvyConverter.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Bg">#0B0F14</Color>
            <Color x:Key="Surface">#181F27</Color>
            <Color x:Key="SurfaceHigh">#212A34</Color>
            <Color x:Key="Line">#2C3740</Color>
            <Color x:Key="Text">#E6EDF3</Color>
            <Color x:Key="Muted">#8B98A5</Color>
            <Color x:Key="Accent">#2DB8CF</Color>
            <Color x:Key="Accent2">#0E8AA1</Color>
            <Color x:Key="Lime">#B0CB1C</Color>
            <Color x:Key="Success">#4EC9B0</Color>
            <Color x:Key="Error">#F14C4C</Color>

            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2DB8CF" Offset="0" />
                <GradientStop Color="#0E8AA1" Offset="1" />
            </LinearGradientBrush>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Text}" />
            </Style>
            <Style x:Key="MutedLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="Section" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="Stroke" Value="{StaticResource Line}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Padding" Value="18" />
            </Style>
            <Style x:Key="Ghost" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHigh}" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
                <Setter Property="BorderColor" Value="{StaticResource Line}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="MinimumHeightRequest" Value="40" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
